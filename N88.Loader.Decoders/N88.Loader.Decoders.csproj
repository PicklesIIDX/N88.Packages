<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.1</TargetFramework>
        <ImplicitUsings>disable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <LangVersion>latest</LangVersion>
        <RootNamespace>N88.Loader.Decoders</RootNamespace>
        <PackageId>N88.Loader.Decoders</PackageId>
        <Version>1.0.0</Version>
        <Company>N88</Company>
        <Description>General Decoders for the N88.Loader</Description>
        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IsPackable>true</IsPackable>
        <PackageLicenseExpression>MIT</PackageLicenseExpression>
        <PackageReleaseNotes>
            - initial commit
        </PackageReleaseNotes>
        <PackageReadmeFile>README.md</PackageReadmeFile>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\N88.Loader\N88.Loader.csproj" />
    </ItemGroup>
    
    <ItemGroup>
        <None Include="README.md" Pack="true" PackagePath="\"/>
    </ItemGroup>

    <Target Name="PackAfterBuild" AfterTargets="Build">
        <Exec Command="dotnet pack -o $(HOME)/dev/.localfeed"/>
    </Target>

</Project>
